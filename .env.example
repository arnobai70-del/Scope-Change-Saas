APP_NAME="Scope Change"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite works out of the box for local development.
# Production: DB_CONNECTION=mysql (MySQL 8.4) with the settings below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=scope_change
# DB_USERNAME=scope_change
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: QUEUE_CONNECTION=redis and run `php artisan queue:work` (or Horizon).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Plans & trial ------------------------------------------------------
PLAN_TRIAL_DAYS=14
PLAN_TRIAL_PLAN=pro

# --- Paddle Billing (merchant of record) --------------------------------
PADDLE_SANDBOX=true
PADDLE_API_KEY=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE=300
PADDLE_PRICE_SOLO_MONTHLY=
PADDLE_PRICE_SOLO_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_AGENCY_MONTHLY=
PADDLE_PRICE_AGENCY_YEARLY=
PADDLE_PRICE_SEAT_MONTHLY=
PADDLE_PRICE_SEAT_YEARLY=

# --- Email provider bounce/complaint webhook ----------------------------
MAIL_WEBHOOK_SECRET=

# --- Security & privacy -------------------------------------------------
SECURITY_HSTS=false
RECORD_CLIENT_IP=true
CLIENT_IP_RETENTION_DAYS=365
ADMIN_REQUIRES_2FA=true
